// Layered graphite: the rail is darkest, the conversation lightest. Marigold marks
// selection, primary actions and messages that mention you, red mention counts and
// destructive actions, green live voice;
// a microphone's level goes from green through orange to red as it nears clipping.
// These are the Yap theme's colours; the application sets others from Rust
// (src/ui/theme.rs), so the defaults here only paint the first frame.
export global Theme {
    in-out property <color> rail: #111215;
    in-out property <color> sidebar: #17181c;
    in-out property <color> panel: #121316;
    in-out property <color> chat: #1e1f24;
    in-out property <color> stage: #1e1f24;
    in-out property <color> raised: #26272e;
    in-out property <color> field: #2a2b32;
    in-out property <color> sunken: #0e0f12;
    in-out property <color> hover: #222329;
    in-out property <color> active: #2c2d35;
    in-out property <color> row-hover: #1a1b20;
    in-out property <color> line: #2c2d34;
    in-out property <color> edge: #0c0d0f;
    /// The faint outline of the sidebar and the top of the window, and under the server name.
    in-out property <color> outline: #2c2d34;
    /// The lines on the conversation's side: under the channel name, and left of the member list.
    in-out property <color> outline-chat: #2c2d34;
    /// The outline of the message box.
    in-out property <color> outline-field: #2c2d34;
    /// The ground of a context menu: on a dark theme Discord's panel, a step
    /// above the raised surfaces (40, 40, 45 on its own dark theme).
    out property <color> menu: self.dark ? self.raised.mix(#ffffff, 0.98) : self.raised;
    /// A context menu's outline (53, 53, 59 on Discord's dark theme).
    out property <color> menu-line: self.dark ? self.line.mix(#000000, 0.95) : self.line;
    in-out property <color> text: #eef0f4;
    in-out property <color> secondary: #b5b8c1;
    in-out property <color> muted: #8d919c;
    in-out property <color> faint: #5c606a;
    in-out property <color> accent: #ffbf47;
    in-out property <color> accent-hover: #ffcd70;
    in-out property <color> on-accent: #1d1607;
    in-out property <color> accent-soft: #ffbf4726;
    // A message that mentions you: Discord's hsl(39.4 100% 48.6%) at 12%, 16% under the pointer.
    in-out property <color> mentioned: #f8a5001f;
    in-out property <color> mentioned-hover: #f8a50029;
    in-out property <color> danger: #f0545e;
    in-out property <color> danger-hover: #f46f77;
    /// A destructive menu row's text and icon, Discord's lighter red on a dark theme.
    /// Discord's composer: a hair lighter than a plain field, with a dimmer placeholder.
    out property <color> composer: self.dark ? self.field.mix(#ffffff, 0.99) : self.field;
    out property <color> placeholder: self.dark ? self.muted.mix(self.field, 0.66) : self.muted;
    out property <color> danger-text: self.dark ? #fa777c : self.danger;
    /// Text and icons on a danger fill: badges, the LIVE pill, leaving a call.
    in-out property <color> on-danger: #ffffff;
    in-out property <color> live: #3ecf7e;
    in-out property <color> loud: #ff8c42;
    in-out property <color> link: #64adf6;
    /// The neutral ActionButton face.
    in-out property <color> button-default: #33343c;
    in-out property <color> button-default-hover: #3c3d46;
    /// Laid over any surface at a low alpha to lift it on hover, and behind an
    /// emoji still loading: white on a dark theme, black on a light one.
    in-out property <color> overlay: #ffffff;
    /// The light that sweeps across a skeleton while it loads.
    in-out property <color> shimmer: #ffffff10;
    /// The line from a reply's avatar to the message it answers.
    in-out property <color> reply-spine: #4a4c56;
    /// The ground of the window's tooltip and the zoom level's note.
    in-out property <color> tooltip: #0b0c0e;
    /// An avatar's ground before Yapfast knows the person's own tint.
    in-out property <color> avatar: #6b7280;
    /// Whether the theme is dark, for the std-widgets that follow the system's scheme.
    in-out property <bool> dark: true;
    out property <duration> quick: 120ms;
}

// Whether the keyboard, rather than the pointer, moved the focus. A focus
// ring shows only then, so a button that happens to hold the initial focus
// has no ring at rest.
export global FocusRing {
    in-out property <bool> keyboard: false;
}

// One tooltip for the whole window, drawn above everything else.
export global Tip {
    in-out property <string> text;
    in-out property <length> x;
    in-out property <length> y;
    /// 0 above, 1 right, 2 below, 3 right of a server tile, 4 above Settings.
    in-out property <int> side;
    /// Whether it pops up with a fade, as a badge's does, not at once.
    in-out property <bool> pop;
}

// The tooltip of a badge that levels up, as Discord's client shows it: a
// large picture of the level, the kind of badge, the level and how far along
// the person is. Empty `title` hides it. `x` and `y` are the badge's top
// centre.
export global BadgeTip {
    in-out property <string> kind;
    in-out property <string> title;
    in-out property <string> progress;
    in-out property <string> picture-url;
    in-out property <length> x;
    in-out property <length> y;
}

// The reaction whose tooltip shows, by message item and key, as Discord's
// client shows it: after the pointer stays on its chip, and until it has left
// both the chip and the tooltip for a moment. `x` and `y` are the chip's top
// centre.
export global ReactionHover {
    in-out property <string> item;
    in-out property <string> key;
    in-out property <length> x;
    in-out property <length> y;
    in-out property <bool> on-chip;
    in-out property <bool> on-tip;
}

// Centres a fixed-size child across a row, which Slint layouts align to the top.
export component Middle inherits VerticalLayout {
    alignment: center;
}

export component Label inherits Text {
    color: Theme.muted; font-size: 13px; wrap: word-wrap;
    vertical-stretch: 0;
}

// Twemoji, as Discord's client draws emoji: `text` gives back a text with each
// emoji in it as the glyph of Twemoji's font that draws its picture, so a
// reaction, a poll's answer or an emoji shown by itself draws Twemoji's picture
// whole, a flag or a skin tone included, and never the system's emoji.
export global Twemoji {
    pure callback text(string) -> string;
}

// Whether Discord's things carry its badge. A build without Matrix shows
// nothing else, so it leaves them off.
// The profile switches in Settings → Appearance. The Rust side keeps them in
// layout.json and leaves out what's off before anything is fetched; see
// Cosmetics in the core.
export global Looks {
    in-out property <bool> profile-effects: true;
    in-out property <bool> decorations: true;
    in-out property <bool> moving: true;
    in-out property <bool> name-styles: true;
    in-out property <bool> server-tags: true;
    in-out property <bool> better-animations: false;
}

export global Badges {
    in property <bool> discord: true;
}

// How popups and overlays open, as Discord's modals do: the card grows subtly
// from 92% as it fades in and lifts 10px, and returns as it fades out when it closes.
export global Popup {
    /// The card fades as it grows, on the GPU. Skia Software draws a
    /// fading card into a layer as large as what changed, which is the
    /// whole window under a dimmed backdrop, so there the card only grows.
    in property <bool> fade: true;
    out property <duration> duration-enter: Looks.better-animations ? 200ms : 0ms;
    out property <duration> duration-exit: Looks.better-animations ? 135ms : 0ms;
    out property <duration> duration: Looks.better-animations ? 200ms : 0ms;
    out property <duration> menu-enter: Looks.better-animations ? 140ms : 0ms;
    out property <duration> tooltip-enter: Looks.better-animations ? 100ms : 0ms;
    out property <duration> anchor-tooltip-enter: Looks.better-animations ? 140ms : 0ms;
    out property <duration> popover-enter: Looks.better-animations ? 160ms : 0ms;
    out property <duration> hover-enter: Looks.better-animations ? 160ms : 0ms;
    out property <duration> hover-exit: Looks.better-animations ? 130ms : 0ms;
    // Navigation / Channel & Workspace switch transitions (BetterAnimations-style)
    out property <duration> switch-enter: Looks.better-animations ? 195ms : 0ms;
    out property <duration> switch-exit: Looks.better-animations ? 75ms : 0ms;
    // Channel / DM vertical offsets
    out property <length> switch-offset: Looks.better-animations ? 24px : 0px;
    out property <length> switch-drift: Looks.better-animations ? -6px : 0px;
    // Server / DM workspace horizontal offsets
    out property <length> switch-offset-x: Looks.better-animations ? 24px : 0px;
    out property <length> switch-drift-x: Looks.better-animations ? -8px : 0px;
    /// The card's size and opacity for how far it's open, from 0 to 1.
    public pure function scale(amount: float) -> float { Looks.better-animations ? (0.92 + 0.08 * amount) : 1.0 }
    public pure function lift(amount: float) -> length { Looks.better-animations ? ((1.0 - amount) * 10px) : 0px }
    public pure function menu-scale(amount: float) -> float { Looks.better-animations ? (0.93 + 0.07 * amount) : 1.0 }
    public pure function popover-scale(amount: float) -> float { Looks.better-animations ? (0.95 + 0.05 * amount) : 1.0 }
    public pure function opacity(amount: float) -> float { root.fade ? (Looks.better-animations ? amount : (amount > 0 ? 1 : 0)) : (amount > 0 ? 1 : 0) }
}

// The way in and out of a popup shown with `if`: `amount` goes from 0 to
// 1 as it opens and back as it closes, and `shown` stays true until the
// way out ends, which the popup's `if` waits for.
export component PopupMotion {
    in property <bool> open;
    in property <duration> entrance: Popup.duration-enter;
    out property <float> amount: self.open ? 1 : 0;
    out property <bool> shown: self.open || (Looks.better-animations && self.amount > 0);
    init => { if self.open { self.amount = 1; } }
    changed open => { self.amount = self.open ? 1 : 0; }
    animate amount {
        duration: self.open ? self.entrance : Popup.duration-exit;
        easing: ease-out;
    }
}
