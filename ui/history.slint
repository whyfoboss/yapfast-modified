import { Avatar, IconButton } from "controls.slint";
import { Theme, Middle, Label } from "theme.slint";
import { ScrollView } from "scrollview.slint";
import { TextBlock, TextBlocks } from "messages.slint";

export struct EditHistoryRow {
    item: string,
    author: string,
    initial: string,
    tint: color,
    picture-url: string,
    color: color,
    has-color: bool,
    when: string,
    version-label: string,
    is-deleted: bool,
    truncated: bool,
    body: string,
    styled: styled-text,
    has-body: bool,
    blocks: [TextBlock],
}

export component EditHistoryCard inherits Rectangle {
    in property <EditHistoryRow> entry;
    callback open-link(string);
    min-height: content.preferred-height;
    border-radius: 8px;
    background: pointer.has-hover ? Theme.hover : Theme.chat;
    border-width: 1px;
    border-color: Theme.line;
    accessible-role: text;
    accessible-label: root.entry.author + ", " + root.entry.when + ", " + root.entry.version-label + " version";

    pointer := TouchArea {
        content := HorizontalLayout {
            padding: 12px;
            spacing: 12px;
            VerticalLayout {
                alignment: start;
                Avatar {
                    size: 36px;
                    initial: root.entry.initial;
                    tint: root.entry.tint;
                    picture-url: root.entry.picture-url;
                }
            }
            VerticalLayout {
                spacing: 4px;
                horizontal-stretch: 1;
                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    Text {
                        text: root.entry.author;
                        color: root.entry.has-color ? root.entry.color : Theme.text;
                        font-size: 14px;
                        font-weight: 600;
                        overflow: elide;
                        vertical-alignment: center;
                    }
                    Text {
                        text: root.entry.when;
                        color: Theme.muted;
                        font-size: 12px;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    // Version badge distinguishing Current/Deleted/Previous/Original
                    Rectangle {
                        border-radius: 4px;
                        background: root.entry.is-deleted
                            ? Theme.danger
                            : root.entry.version-label == "Current"
                                ? Theme.raised
                                : root.entry.version-label == "Original"
                                    ? Theme.edge
                                    : Theme.sunken;
                        HorizontalLayout {
                            padding-left: 6px;
                            padding-right: 6px;
                            padding-top: 2px;
                            padding-bottom: 2px;
                            Text {
                                text: root.entry.version-label;
                                color: root.entry.is-deleted ? Theme.on-danger : Theme.secondary;
                                font-size: 11px;
                                font-weight: 700;
                                vertical-alignment: center;
                            }
                        }
                    }
                    Rectangle { horizontal-stretch: 1; }
                }
                if root.entry.has-body && root.entry.blocks.length == 0: StyledText {
                    min-width: 0px;
                    text: root.entry.styled;
                    default-color: root.entry.is-deleted ? Theme.danger-text : Theme.text;
                    link-color: Theme.link;
                    default-font-size: 14px;
                    max-lines: 10;
                    link-clicked(link) => { root.open-link(link); }
                }
                if root.entry.blocks.length > 0: TextBlocks {
                    blocks: root.entry.blocks;
                    font-size: 14px;
                    max-lines: 10;
                    color: root.entry.is-deleted ? Theme.danger-text : Theme.text;
                    open-link(link) => { root.open-link(link); }
                }
                if root.entry.truncated: HorizontalLayout {
                    padding-top: 2px;
                    Text {
                        text: "[Truncated: exceeded 2,000 characters memory limit]";
                        color: Theme.muted;
                        font-size: 11px;
                        font-italic: true;
                    }
                }
            }
        }
    }
}

export component EditHistoryPanel inherits Rectangle {
    in property <[EditHistoryRow]> entries;
    in property <string> heading;
    callback open-link(string);
    callback close;

    background: Theme.sidebar;
    accessible-role: list;
    accessible-label: "Edit history";

    Rectangle { x: 0; width: 1px; background: Theme.edge; }

    VerticalLayout {
        Rectangle {
            height: 48px;
            HorizontalLayout {
                padding-left: 16px;
                padding-right: 10px;
                spacing: 10px;
                Text {
                    text: root.heading != "" ? root.heading : "Edit History";
                    color: Theme.text;
                    font-size: 15px;
                    font-weight: 700;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
                Middle {
                    IconButton {
                        icon: @image-url("icons/x.svg");
                        label: "Close edit history";
                        size: 28px;
                        glyph: 18px;
                        tip-side: 2;
                        clicked => { root.close(); }
                    }
                }
            }
            Rectangle { y: parent.height - 1px; height: 1px; background: Theme.line; }
        }
        if root.entries.length == 0: HorizontalLayout {
            padding: 16px;
            Label { text: "No previous versions recorded."; }
        }
        ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                padding: 12px;
                spacing: 8px;
                alignment: start;
                for entry in root.entries: EditHistoryCard {
                    entry: entry;
                    open-link(link) => { root.open-link(link); }
                }
            }
        }
    }
}
